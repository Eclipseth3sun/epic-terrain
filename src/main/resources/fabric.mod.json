{
	"schemaVersion": 1,
	"id": "epicterrain",
	"version": "${version}",
	"name": "Tectonic Terrain",
	"description": "Earth: a world type whose continent is shaped by simulated plate tectonics, erosion and climate, with rivers, lakes, islands in the open ocean, and vanilla's caves and structures.",
	"authors": [
		"Eclipseth3sun"
	],
	"contact": {
		"homepage": "https://github.com/Eclipseth3sun/epic-terrain",
		"sources": "https://github.com/Eclipseth3sun/epic-terrain",
		"issues": "https://github.com/Eclipseth3sun/epic-terrain/issues"
	},
	"license": "MIT",
	"icon": "assets/epicterrain/icon.png",
	"environment": "*",
	"accessWidener": "epicterrain.accesswidener",
	"entrypoints": {
		"main": [
			"com.epicterrain.EpicTerrain"
		]
	},
	"mixins": [
		"epicterrain.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.20.1",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	}
}
